#!/usr/bin/env python3
# Falso de gsettings: el valor de show-banners es el último "set" del registro (o FAKE_BANNERS, "true" por defecto).
import json, os, sys
a = sys.argv[1:]
ruta = os.environ["FAKE_LOG"]
if os.environ.get("FAKE_GSETTINGS_FALLA") == "1":
    sys.stderr.write("sin dconf\n"); sys.exit(1)
valor = os.environ.get("FAKE_BANNERS", "true")
for l in open(ruta).read().splitlines():
    d = json.loads(l)
    if d["cmd"] == "gsettings" and d["argv"][0] == "set":
        valor = d["argv"][-1]
open(ruta, "a").write(json.dumps({"cmd": "gsettings", "argv": a}) + "\n")
if a and a[0] == "get":
    print(valor)
