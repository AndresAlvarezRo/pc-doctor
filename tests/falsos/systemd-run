#!/usr/bin/env python3
# Imita una unidad transitoria: registra las propiedades y corre el comando de después de "--" en segundo plano.
import json, os, subprocess, sys
a = sys.argv[1:]
i = a.index("--")
env = dict(os.environ)
for x in a[:i]:
    if x.startswith("--setenv="):
        k, v = x[len("--setenv="):].split("=", 1); env[k] = v
open(os.environ["FAKE_LOG"], "a").write(json.dumps({"cmd": "systemd-run", "opciones": a[:i], "comando": a[i + 1:][2:3]}) + "\n")
if os.environ.get("FAKE_SYSTEMD_RUN_FALLA") == "1":
    sys.stderr.write("Failed to connect to bus\n"); sys.exit(1)
subprocess.Popen(a[i + 1:], env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
