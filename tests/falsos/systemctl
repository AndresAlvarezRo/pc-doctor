#!/usr/bin/env python3
import json, os, subprocess, sys
a = sys.argv[1:]
open(os.environ["FAKE_LOG"], "a").write(json.dumps({"cmd": "systemctl", "argv": a}) + "\n")
if "list-units" in a:
    for n in range(int(os.environ.get("FAKE_ESCUCHAS", "0"))): print(f"pc-doctor-notif-{n}.service loaded active running x")
    sys.exit(0)
if "is-active" in a:
    print(os.environ.get("FAKE_ACTIVO", "active")); sys.exit(0 if os.environ.get("FAKE_ACTIVO", "active") == "active" else 3)
if "start" in a:
    if os.environ.get("FAKE_SERVICIO") == "ausente":
        sys.stderr.write("Failed to start pc-doctor-web.service: Unit pc-doctor-web.service not found.\n"); sys.exit(5)
    if os.environ.get("FAKE_SERVICIO") == "roto": sys.exit(0)   # dice que arrancó pero nunca responde
    subprocess.Popen([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "servidor_falso.py")], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=open(os.environ["FAKE_LOG"] + ".err", "a"))
