#!/usr/bin/env python3
import json, os, sys, time
open(os.environ["FAKE_LOG"], "a").write(json.dumps({"cmd": "notify-send", "argv": sys.argv[1:]}) + "\n")
acciones = [a for a in sys.argv[1:] if a.startswith("--action=")]
if os.environ.get("FAKE_NOTIFY_FALLA") == "1" and not acciones:
    sys.stderr.write("no bus\n"); sys.exit(1)
if acciones and os.environ.get("FAKE_ACCION_FALLA") == "1":
    sys.stderr.write("acciones no soportadas\n"); sys.exit(1)
if acciones:
    time.sleep(float(os.environ.get("FAKE_DEMORA", "0.3")))
    if os.environ.get("FAKE_CLIC") == "1":
        print(acciones[0].split("=")[1])
